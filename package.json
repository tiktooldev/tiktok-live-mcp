{
  "name": "tiktok-live-mcp",
  "version": "0.2.3",
  "description": "MCP server for the TikTok LIVE API - detect live creators, room and creator data, gifts, and leaderboards from any TikTok LIVE stream.",
  "type": "module",
  "bin": {
    "tiktok-live-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').cpSync('src','dist',{recursive:true})\" && node strip-comments.mjs dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tiktok",
    "tiktok-live",
    "livestream",
    "claude",
    "cursor",
    "llm",
    "ai-tools"
  ],
  "author": "TikTool",
  "license": "MIT",
  "homepage": "https://tik.tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiktooldev/tiktok-live-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
