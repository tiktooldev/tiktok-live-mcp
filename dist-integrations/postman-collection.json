              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unique_id\": \"charlidamelio\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webcast/room_info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webcast",
                "room_info"
