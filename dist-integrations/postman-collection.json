{
  "info": {
    "name": "TikTok LIVE API",
    "description": "Real-time TikTok LIVE data: liveness detection, room and creator info, in-room and regional rankings, gift catalogs, and live discovery.\n\nBase URL: https://api.tik.tools\nAuth: send your key in the x-api-key header (or as ?apiKey=). Get a free key at https://tik.tools/pricing and upgrade there for full leaderboards, agency recruiting feeds, and multi-region discovery.\n\nSet the collection variables apiKey and baseUrl, then run any request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.tik.tools",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "REPLACE_WITH_YOUR_KEY",
      "type": "string"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Live detection",
      "item": [
        {
          "name": "Check alive",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webcast/check_alive?unique_id=charlidamelio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webcast",
                "check_alive"
              ],
              "query": [
                {
                  "key": "unique_id",
                  "value": "charlidamelio",
                  "description": "TikTok username without @"
                }
              ]
            },
            "description": "Is the creator currently live. Sandbox tier."
          }
        },
        {
          "name": "Live status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webcast/live_status?uniqueId=charlidamelio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webcast",
                "live_status"
              ],
              "query": [
                {
                  "key": "uniqueId",
                  "value": "charlidamelio",
                  "description": "TikTok username without @"
                }
              ]
            },
            "description": "Fast instant liveness check. Sandbox tier."
          }
        }
      ]
    },
