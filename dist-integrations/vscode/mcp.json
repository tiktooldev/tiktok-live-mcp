{
  "inputs": [
    {
      "type": "promptString",
      "id": "tiktools-api-key",
      "description": "TikTok LIVE API key (get one at https://tik.tools/pricing, 7-day free evaluation)",
      "password": true
    }
  ],
  "servers": {
    "tiktok-live": {
      "command": "npx",
      "args": ["-y", "tiktok-live-mcp"],
      "env": {
        "TIKTOOLS_API_KEY": "${input:tiktools-api-key}"
      }
    }
  }
}
